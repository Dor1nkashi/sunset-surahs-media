   ],
   "quran": {
    "ref": "12:33",
    "surah": "Yusuf",
    "ar": "رَبِّ ٱلسِّجۡنُ أَحَبُّ إِلَیَّ مِمَّا یَدۡعُونَنِیۤ إِلَیۡهِۖ"
   }
  },
  {
   "id": "d2",
   "kind": "dlg",
   "t0": 11.745,
   "t1": 17.512,
   "text": "And if You do not avert from me their plan, I might incline toward them and [thus] be of the ignorant.",
