   ],
   "quran": {
    "ref": "12:33",
    "surah": "Yusuf",
    "ar": "وَإِلَّا تَصۡرِفۡ عَنِّی كَیۡدَهُنَّ أَصۡبُ إِلَیۡهِنَّ وَأَكُن مِّنَ ٱلۡجَـٰهِلِینَ"
   }
  },
  {
   "id": "d3",
